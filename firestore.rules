rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    // Workspace & Business Collections
    match /bos_businesses/{businessId} {
      allow read, write: if true;
    }
    match /bos_users/{userId} {
      allow read, write: if true;
    }
    match /bos_products/{productId} {
      allow read, write: if true;
    }
    match /bos_services/{serviceId} {
      allow read, write: if true;
    }
    match /bos_customers/{customerId} {
      allow read, write: if true;
    }
    match /bos_sales/{saleId} {
      allow read, write: if true;
    }
    match /bos_expenses/{expenseId} {
      allow read, write: if true;
    }
    match /bos_logs/{logId} {
      allow read, write: if true;
    }
    match /bos_branches/{branchId} {
      allow read, write: if true;
    }
    match /bos_customer_returns/{id} {
      allow read, write: if true;
    }
    match /bos_supplier_returns/{id} {
      allow read, write: if true;
    }
    match /bos_stock_transfers/{id} {
      allow read, write: if true;
    }
    match /bos_global_features/{id} {
      allow read, write: if true;
    }
    match /bos_feature_audit_logs/{id} {
      allow read, write: if true;
    }
    match /bos_service_jobs/{id} {
      allow read, write: if true;
    }
    match /bos_menu_items/{id} {
      allow read, write: if true;
    }
    match /bos_ingredients/{id} {
      allow read, write: if true;
    }
    match /bos_recipes/{id} {
      allow read, write: if true;
    }
    match /bos_restaurant_tables/{id} {
      allow read, write: if true;
    }
    match /bos_restaurant_orders/{id} {
      allow read, write: if true;
    }
    match /bos_reservations/{id} {
      allow read, write: if true;
    }
    match /bos_suppliers/{id} {
      allow read, write: if true;
    }
    match /bos_notifications/{id} {
      allow read, write: if true;
    }
    match /bos_printer_settings/{id} {
      allow read, write: if true;
    }
    match /bos_fast_food_orders/{id} {
      allow read, write: if true;
    }
    match /bos_fast_food_ingredients/{id} {
      allow read, write: if true;
    }
    match /bos_fast_food_menu_items/{id} {
      allow read, write: if true;
    }
    match /bos_fast_food_recipes/{id} {
      allow read, write: if true;
    }
    match /bos_notification_preferences/{id} {
      allow read, write: if true;
    }
    match /bos_push_device_tokens/{id} {
      allow read, write: if true;
    }
    match /bos_notification_logs/{id} {
      allow read, write: if true;
    }
    match /bos_salon_appointments/{id} {
      allow read, write: if true;
    }
    match /bos_salon_staff/{id} {
      allow read, write: if true;
    }
    match /bos_laundry_orders/{id} {
      allow read, write: if true;
    }
    match /bos_scanner_sessions/{id} {
      allow read, write: if true;
    }
    match /bos_scanned_items/{id} {
      allow read, write: if true;
    }
    match /bos_print_commands/{id} {
      allow read, write: if true;
    }
    match /bos_payment_transactions/{id} {
      allow read, write: if true;
    }
    match /bos_paynow_settings/{id} {
      allow read, write: if true;
    }
    match /bos_global_system_config/{id} {
      allow read, write: if true;
    }
    match /bos_travel_customers/{id} {
      allow read, write: if true;
    }
    match /bos_travel_bookings/{id} {
      allow read, write: if true;
    }
    match /bos_travel_flights/{id} {
      allow read, write: if true;
    }
    match /bos_travel_hotels/{id} {
      allow read, write: if true;
    }
    match /bos_travel_visas/{id} {
      allow read, write: if true;
    }
    match /bos_travel_passports/{id} {
      allow read, write: if true;
    }
    match /bos_travel_packages/{id} {
      allow read, write: if true;
    }
    match /bos_travel_transports/{id} {
      allow read, write: if true;
    }
    match /bos_travel_insurances/{id} {
      allow read, write: if true;
    }
    match /bos_travel_suppliers/{id} {
      allow read, write: if true;
    }
    match /bos_travel_partners/{id} {
      allow read, write: if true;
    }
    match /bos_travel_documents/{id} {
      allow read, write: if true;
    }
    match /bos_travel_marketings/{id} {
      allow read, write: if true;
    }
  }
}
